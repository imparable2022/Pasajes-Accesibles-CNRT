+    def _clear_date_editor(self, prefix: str):
+        text_ctrl = getattr(self, f"{prefix}_date", None)
+        if text_ctrl is not None:
+            text_ctrl.ChangeValue("")
+        for suffix in ("day", "month", "year"):
+            control = getattr(self, f"{prefix}_{suffix}", None)
+            if control is not None:
+                control.SetSelection(wx.NOT_FOUND)
+
+    def on_clear_search_fields(self, event=None):
+        # Limpiar solo afecta los datos de esta búsqueda. Las credenciales, el
+        # perfil, la cantidad de pasajes y la pausa configurada se conservan.
+        for later in self._locality_later.values():
+            try:
+                if later is not None and later.IsRunning():
+                    later.Stop()
+            except Exception:
+                pass
+
+        if self.scan_cancel_event is not None and not self.scan_cancel_event.is_set():
+            self._discard_scan_result = True
+            self.scan_cancel_event.set()
+
+        self.origin_results = []
+        self.destination_results = []
+        self.selected_origin = None
+        self.selected_destination = None
+        self.scan_services = []
+        self.last_scan_result = None
+        self.pending_service = None
+        self._locality_nav_index = {"origin": -1, "destination": -1}
+        self._accept_locality_after_search = {"origin": False, "destination": False}
+        self._search_fields_cleared = True
+
+        for combo_name in ("origin_combo", "destination_combo"):
+            combo = getattr(self, combo_name, None)
+            if combo is not None:
+                combo.Clear()
+                combo.ChangeValue("")
+
+        for prefix in ("travel", "from", "to"):
+            self._clear_date_editor(prefix)
+
+        self._apply_control_theme()
+        self.content.Layout()
+        self.content.FitInside()
+        self.origin_combo.SetFocus()
+        self._announce(
+            "Datos de búsqueda limpiados. Origen, destino y fechas quedaron vacíos."
+        )
 
