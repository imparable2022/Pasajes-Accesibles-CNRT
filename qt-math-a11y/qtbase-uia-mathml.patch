+PROPERTYID mathMlPropertyId()
+{
+    static const PROPERTYID id = [] {
+        ComPtr<IUIAutomationRegistrar> registrar;
+        if (FAILED(CoCreateInstance(CLSID_CUIAutomationRegistrar, nullptr, CLSCTX_INPROC_SERVER,
+                                    IID_PPV_ARGS(&registrar))))
+            return PROPERTYID{};
+
+        static const GUID mathMlGuid = {
+            0xfa170ab3, 0x3229, 0x4e7c, { 0x82, 0x7f, 0xdd, 0x05, 0xee, 0x04, 0x81, 0xd9 }
+        };
+        UIAutomationPropertyInfo info = { mathMlGuid, L"MathML", UIAutomationType_String };
+        PROPERTYID propertyId = 0;
+        if (FAILED(registrar->RegisterProperty(&info, &propertyId)))
+            return PROPERTYID{};
+        return propertyId;
+    }();
+    return id;
+}
+
