+                    "--wait-pid",
+                    str(os.getpid()),
+                    "--source",
+                    str(staging),
+                    "--target",
+                    str(root),
+                    "--app",
+                    APP_EXECUTABLE,
+                ],
+                cwd=str(helper_dir),
